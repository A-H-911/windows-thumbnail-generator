{
  "title": "Thumbnail Cache Priming Flow",
  "direction": "ltr",
  "numbering": true,
  "markers": false,
  "lanes": [
    {"id": "user",     "label": "User"},
    {"id": "mainform", "label": "MainForm (UI)"},
    {"id": "primer",   "label": "ThumbnailCachePrimer"},
    {"id": "com",      "label": "Windows Shell COM"}
  ],
  "steps": [
    {"id": "s1",        "lane": "user",     "label": "Click Prime Cache"},
    {"id": "s2",        "lane": "mainform", "label": "Validate folder & create CTS"},
    {"id": "s3",        "lane": "mainform", "label": "Call PrimeAsync, await Task"},
    {"id": "s4",        "lane": "primer",   "label": "Spawn STA Thread"},
    {"id": "s5",        "lane": "primer",   "label": "CollectImages (cycle detection)"},
    {"id": "s6",        "lane": "com",      "label": "Create IThumbnailCache"},
    {"id": "s7",        "lane": "primer",   "label": "Check CancellationToken [per-file]"},
    {"id": "s8",        "lane": "com",      "label": "SHCreateItemFromParsingName"},
    {"id": "s9",        "lane": "com",      "label": "GetThumbnail WTS_EXTRACT"},
    {"id": "s10",       "lane": "primer",   "label": "Track result; check failure thresholds"},
    {"id": "s11",       "lane": "com",      "label": "Recycle IThumbnailCache (proactive / crisis)", "optional": true},
    {"id": "s12",       "lane": "primer",   "label": "Report progress (every 50 files)"},
    {"id": "s13",       "lane": "mainform", "label": "Update progress bar & log skips"},
    {"id": "s14",       "lane": "com",      "label": "VerifyCacheEntry WTS_INCACHEONLY"},
    {"id": "s15",       "lane": "primer",   "label": "tcs.SetResult(bool?)"},
    {"id": "s16",       "lane": "mainform", "label": "Show Done / Warning"},
    {"id": "cancelled", "lane": "mainform", "label": "Show \"Cancelled\"", "terminal": true},
    {"id": "abort",     "lane": "mainform", "label": "Show Error (abort)",  "terminal": true}
  ],
  "edges": [
    {"from": "s1",  "to": "s2"},
    {"from": "s2",  "to": "s3"},
    {"from": "s3",  "to": "s4"},
    {"from": "s4",  "to": "s5"},
    {"from": "s5",  "to": "s6"},
    {"from": "s6",  "to": "s7"},
    {"from": "s7",  "to": "s8",        "label": "token valid"},
    {"from": "s7",  "to": "cancelled", "label": "cancelled"},
    {"from": "s8",  "to": "s9"},
    {"from": "s9",  "to": "s10"},
    {"from": "s10", "to": "s11",       "label": "recycle triggered"},
    {"from": "s10", "to": "s12",       "label": "continue"},
    {"from": "s10", "to": "abort",     "label": ">80% fail or max recycles"},
    {"from": "s11", "to": "s12"},
    {"from": "s12", "to": "s13"},
    {"from": "s13", "to": "s7",        "label": "next file"},
    {"from": "s13", "to": "s14",       "label": "all files done"},
    {"from": "s14", "to": "s15"},
    {"from": "s15", "to": "s16"}
  ]
}
